{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Administrator details and authorization status",
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean",
          "description": "Indicates if the administrator is active and authorized"
        }
      },
      "required": ["active"]
    },
    "Ad": {
      "title": "Ad",
      "description": "An advertisement displayed in the application sidebars",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title or name of the advertisement"
        },
        "imageUrl": {
          "type": "string",
          "description": "Base64 data URI or web URL of the ad image"
        },
        "storagePath": {
          "type": "string",
          "description": "Optional Cloud Storage path for the image asset"
        },
        "destinationUrl": {
          "type": "string",
          "description": "URL to redirect the user to when they click the ad"
        },
        "altText": {
          "type": "string",
          "description": "Alternative text for accessibility"
        },
        "position": {
          "type": "string",
          "enum": ["sidebar_top", "sidebar_bottom"],
          "description": "Position in the layout where the ad is displayed"
        },
        "active": {
          "type": "boolean",
          "description": "Whether the ad is currently active and should be displayed"
        },
        "startDate": {
          "type": "string",
          "description": "The date when the ad should start being shown"
        },
        "endDate": {
          "type": "string",
          "description": "The optional date when the ad should stop being shown"
        }
      },
      "required": ["title", "imageUrl", "destinationUrl", "altText", "position", "active", "startDate"]
    },
    "HomeBanner": {
      "title": "HomeBanner",
      "description": "A featured promotional or informative banner displayed on the home page carousel",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name or title of the banner"
        },
        "imageUrl": {
          "type": "string",
          "description": "Image URL or data URI of the banner (1320x480 standard)"
        },
        "linkUrl": {
          "type": "string",
          "description": "Optional destination link or internal route"
        },
        "order": {
          "type": "number",
          "description": "Display order index"
        },
        "active": {
          "type": "boolean",
          "description": "Whether the banner is active"
        },
        "altText": {
          "type": "string",
          "description": "Accessibility alt text"
        }
      },
      "required": ["name", "imageUrl", "order", "active"]
    },
    "SeoConfig": {
      "title": "SeoConfig",
      "description": "SEO metadata overrides per route",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "canonicalPath": { "type": "string" },
        "h1": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "robots": { "type": "string" },
        "ogType": { "type": "string" },
        "ogTitle": { "type": "string" },
        "ogDescription": { "type": "string" },
        "ogImage": { "type": "string" },
        "twitterCard": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "SiteMetric": {
      "title": "SiteMetric",
      "description": "Aggregated privacy-safe site metrics and tool events",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "pageViews": { "type": "number" },
        "conversions": { "type": "number" },
        "downloads": { "type": "number" },
        "routes": { "type": "object" },
        "tools": { "type": "object" },
        "toolConversions": { "type": "object" },
        "toolDownloads": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "admins/{uid}": {
      "schema": "Admin",
      "description": "Administrators who have authorization to manage configurations and ads"
    },
    "ads/{adId}": {
      "schema": "Ad",
      "description": "Advertisements managed by administrators and displayed to users"
    },
    "home_banners/{bannerId}": {
      "schema": "HomeBanner",
      "description": "Featured home carousel banners"
    },
    "seo_configs/{routeKey}": {
      "schema": "SeoConfig",
      "description": "SEO metadata overrides per route"
    },
    "site_metrics/{docId}": {
      "schema": "SiteMetric",
      "description": "Aggregated daily and total site metrics"
    }
  }
}
