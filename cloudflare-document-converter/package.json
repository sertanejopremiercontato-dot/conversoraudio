{
  "name": "multiconverte-cloudflare-document-converter",
  "version": "1.0.0",
  "description": "Cloudflare Worker + Container LibreOffice Document Converter for MultiConverte",
  "main": "dist/container.js",
  "scripts": {
    "start": "node dist/container.js",
    "dev": "tsx watch src/container.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "build:container": "tsc -p tsconfig.json",
    "build:worker": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "formidable": "^3.5.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240329.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/formidable": "^3.4.5",
    "@types/node": "^20.11.30",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "wrangler": "^3.40.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
