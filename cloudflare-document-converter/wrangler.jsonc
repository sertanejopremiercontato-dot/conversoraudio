{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multiconverte-document-converter",
  "main": "src/worker.ts",
  "compatibility_date": "2024-03-20",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "DocumentConverterContainer",
      "image": "./Dockerfile",
      "max_instances": 2,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCUMENT_CONVERTER",
        "class_name": "DocumentConverterContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DocumentConverterContainer"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://multiconverte.com.br,https://www.multiconverte.com.br,http://localhost:5173",
    "CONTAINER_PORT": "8080"
  },
  "observability": {
    "enabled": true
  }
}
